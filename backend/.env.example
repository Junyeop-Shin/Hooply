DATABASE_URL=postgresql+psycopg://hoops:hoops@localhost:5432/hoops
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_BASE_URL=http://localhost:5173
TIMEZONE=Asia/Seoul
TEAM_APPROVAL_REQUIRED=true
# 운영: DOCS_ENABLED=false, ADMIN_COOKIE_SECURE=true (HTTPS), JWT_SECRET_KEY 는 반드시 긴 난수로
DOCS_ENABLED=true
ADMIN_COOKIE_SECURE=false
# 비밀번호 재설정 메일 (Resend). 비우면 링크를 서버 로그에만 출력
RESEND_API_KEY=
MAIL_FROM=HOOPLY <onboarding@resend.dev>
# AI 설명 (docs/07). LangChain init_chat_model 형식. 키를 비우면 AI 카드는 규칙 문장만 보여 준다
LLM_ENABLED=true
LLM_MODEL=google_genai:gemini-flash-lite-latest
LLM_FALLBACK_MODEL=google_genai:gemini-flash-latest
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
